# --- Ma'lumotlar bazasi: Neon PostgreSQL (Vercel → Storage → baza → .env.local tab) ---
# Pooled ulanish (host'da "-pooler" bor) — ilova uchun
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# To'g'ridan ulanish ("-pooler"siz) — prisma db push uchun
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 32+ belgili tasodifiy qator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-change-me-change-me-change-me"

ADMIN_EMAIL="admin@example.com"
# npm run hash -- "parolingiz"  (.env uchun $ lar \$ bilan chiqadi; Vercel panelida \ larsiz qo'ying)
ADMIN_PASSWORD_HASH=''

# --- Email (Gmail: smtp.gmail.com, 465, App Password) ---
# SMTP bo'sh bo'lsa, dev rejimda xatlar .mail-outbox/ ga yoziladi
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Blog <no-reply@example.com>"

# --- Rasmlar: Cloudflare R2 (bo'sh bo'lsa lokal diskka — faqat dev) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Bucket'ning ommaviy manzili: https://pub-xxxx.r2.dev yoki https://media.sizning-domen.uz
R2_PUBLIC_URL=""

# Saytning to'liq manzili (emaildagi havolalar va SEO uchun)
SITE_URL="http://localhost:3000"

# Test rejimi: SMTP bo'lsa ham xatlar faqat .mail-outbox/ ga (E2E uchun)
# MAIL_OUTBOX="1"
